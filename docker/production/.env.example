# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#
# Generate the two passwords with:
#   openssl rand -hex 24
# Keep them out of your shell history and do not reuse them anywhere else.

CHURCHCRM_DB_NAME=churchcrm
CHURCHCRM_DB_USER=churchcrm

# Required, and deliberately left empty: Compose refuses to start until you
# fill both in, so copying this file unedited cannot bring up a database with
# a password that is public knowledge. Use two different values.
CHURCHCRM_DB_PASSWORD=
CHURCHCRM_DB_ROOT_PASSWORD=

# Where the app is published on the host. Loopback only by default; put a
# TLS reverse proxy in front for anything reachable from outside this machine.
# Use 0.0.0.0:8080 only if you understand that it exposes plain HTTP.
CHURCHCRM_HTTP_ADDR=127.0.0.1:8080
