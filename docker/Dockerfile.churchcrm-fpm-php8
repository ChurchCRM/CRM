# syntax=docker/dockerfile:1
# Production PHP-FPM Dockerfile for ChurchCRM
# Includes compiled ChurchCRM release code (no rebuild needed)
#
# Build:
#   docker build --target prod -f Dockerfile.churchcrm-fpm-php8 -t churchcrm/crm:7.7.0-php8-fpm .
#
# The release code is copied into the image during build.
# When container starts, ChurchCRM is ready to serve.

ARG PHP_IMAGE=php:8.4.25-fpm-trixie@sha256:223115611852f585846b5d30f0cd95de8af9b486ca3bf310174a143704fc71e3

# Builder stage: compile PHP extensions only (code comes from release artifact)
FROM ${PHP_IMAGE} AS builder
WORKDIR /var/www/html
LABEL maintainer="ChurchCRM"

# Install system dependencies required by PHP extensions
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libcurl4-openssl-dev \
        libfreetype6-dev \
        libicu-dev \
        libjpeg-dev \
        libonig-dev \
        libpng-dev \
        libxml2-dev \
        libzip-dev \
        gettext \
        locales \
        locales-all \
        unzip \
    && rm -rf /var/lib/apt/lists/*

# Install and configure PHP extensions
RUN docker-php-ext-configure gd --with-freetype --with-jpeg && \
    docker-php-ext-install -j$(nproc) \
        bcmath \
        curl \
        exif \
        gd \
        gettext \
        iconv \
        intl \
        mbstring \
        mysqli \
        opcache \
        pdo_mysql \
        xml \
        zip

# Configure PHP settings for production
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" && \
    sed -i 's/^upload_max_filesize.*$/upload_max_filesize = 2M/g' $PHP_INI_DIR/php.ini && \
    sed -i 's/^post_max_size.*$/post_max_size = 2G/g' $PHP_INI_DIR/php.ini && \
    sed -i 's/^memory_limit.*$/memory_limit = 256M/g' $PHP_INI_DIR/php.ini && \
    sed -i 's/^max_execution_time.*$/max_execution_time = 120/g' $PHP_INI_DIR/php.ini && \
    sed -i 's/^display_errors.*$/display_errors = Off/g' $PHP_INI_DIR/php.ini


# Production stage: minimal runtime with compiled ChurchCRM
FROM ${PHP_IMAGE} AS prod
WORKDIR /var/www/html
LABEL maintainer="ChurchCRM" \
      org.opencontainers.image.source="https://github.com/ChurchCRM/CRM" \
      org.opencontainers.image.description="ChurchCRM with PHP-FPM (includes release code)"

EXPOSE 9000

# Install only runtime libraries (no dev tools)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libcurl4t64 \
        libfreetype6 \
        libicu76 \
        libjpeg62-turbo \
        libonig5 \
        libpng16-16t64 \
        libxml2 \
        libzip5 \
        gettext \
        locales \
        locales-all \
    && apt-get purge -y --auto-remove $PHPIZE_DEPS libc6-dev libc-dev-bin libcrypt-dev linux-libc-dev rpcsvc-proto && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt /usr/src/php.tar.xz /usr/local/include/php

# Set working directory
WORKDIR /var/www/html

# Copy compiled PHP extensions and configuration from builder. Copying the
# whole extensions/ dir (rather than hardcoding the no-debug-non-zts-<abi>
# subdirectory name) keeps this working if PHP_IMAGE is ever bumped.
COPY --from=builder /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=builder /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/
COPY --from=builder /usr/local/etc/php/php.ini /usr/local/etc/php/php.ini

# Copy ChurchCRM release code (provided from release artifact during docker build)
# The build context should include the extracted release code
COPY --chown=www-data:www-data . .

# The build context also carries docker/apache/default.conf, added so the
# Apache image's Dockerfile can consume it — strip it here so this image
# doesn't ship an unrelated, unused Apache config file.
RUN rm -rf apache && chmod 0755 /var/www/html

# Set non-root user for PHP-FPM
USER www-data


# Dev stage: includes build tools (for developers, not production)
FROM ${PHP_IMAGE} AS dev
LABEL maintainer="ChurchCRM"

# Install system dependencies required by PHP extensions
RUN apt-get update && \
    apt-get install -y \
        libcurl4-openssl-dev \
        libfreetype6-dev \
        libicu-dev \
        libjpeg-dev \
        libonig-dev \
        libpng-dev \
        libxml2-dev \
        libzip-dev \
        gettext \
        locales \
        locales-all \
        unzip \
    && rm -rf /var/lib/apt/lists/*

# Install and configure PHP extensions
RUN docker-php-ext-configure gd --with-freetype --with-jpeg && \
    docker-php-ext-install -j$(nproc) \
        bcmath \
        curl \
        exif \
        gd \
        gettext \
        iconv \
        intl \
        mbstring \
        mysqli \
        opcache \
        pdo_mysql \
        xml \
        zip

# Configure PHP settings
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" && \
    sed -i 's/^upload_max_filesize.*$/upload_max_filesize = 2M/g' $PHP_INI_DIR/php.ini && \
    sed -i 's/^post_max_size.*$/post_max_size = 2G/g' $PHP_INI_DIR/php.ini && \
    sed -i 's/^memory_limit.*$/memory_limit = 256M/g' $PHP_INI_DIR/php.ini && \
    sed -i 's/^max_execution_time.*$/max_execution_time = 120/g' $PHP_INI_DIR/php.ini

# Install development tools and NVM + Node.js
RUN apt-get update && \
    apt-get install -y \
        git \
        make \
        python3 \
        curl \
    && rm -rf /var/lib/apt/lists/* && \
    curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.5/install.sh -o /opt/node-install.sh && \
    chmod a+x /opt/node-install.sh && \
    /opt/node-install.sh && \
    rm /opt/node-install.sh && \
    /bin/bash -c "source /root/.nvm/nvm.sh && nvm install 24 && npm install -g node-gyp" && \
    pecl install xdebug && docker-php-ext-enable xdebug

# Install Composer with checksum verification
RUN php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');" && \
    php -r "if (hash_file('sha384', 'composer-setup.php') === trim(file_get_contents('https://composer.github.io/installer.sig'))) { echo 'Installer verified'; } else { echo 'Installer corrupt'; unlink('composer-setup.php'); exit(1); }" && \
    php composer-setup.php --install-dir=/usr/local/bin --filename=composer && \
    rm composer-setup.php

WORKDIR /var/www/html
