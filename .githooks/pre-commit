#!/usr/bin/env bash
#
# ChurchCRM pre-commit hook — runs two fast, scoped checks on what's actually
# staged in this commit (not the whole repo):
#   1. Translatable-string rules in .agents/skills/churchcrm/i18n-localization.md
#      (no trailing colon, no HTML/markup, no decorative wrapper punctuation
#      baked into gettext()/i18next.t() calls).
#   2. PHP syntax (`php -l`) on changed .php files only. The full 700+ file
#      scan (`npm run build:php:validate:all`) still runs in CI — this is
#      just a fast local guard so a typo isn't caught 10 minutes later in CI.
#
# Enabled automatically by `npm install` (the `prepare` script in
# package.json points core.hooksPath at this directory). To bypass for
# emergency hot-fixes only, run with `git commit --no-verify` — but you
# MUST justify it in the PR description.

set -e

# Skip the hook in CI environments
if [ -n "$CI" ] || [ -n "$GITHUB_ACTIONS" ]; then
    exit 0
fi

# Skip if there is no package.json (e.g. detached worktree)
if [ ! -f package.json ]; then
    exit 0
fi

echo "→ pre-commit: checking staged translatable strings (node scripts/locale-check.js --staged)…"

if ! node scripts/locale-check.js --staged; then
    echo ""
    echo "✘ pre-commit: locale-check found issues in the strings you staged."
    echo "  Fix the issues above and re-stage, or bypass in an emergency with:"
    echo "  git commit --no-verify (justify in PR)."
    exit 1
fi

echo "✓ pre-commit: locale-check passed."

echo "→ pre-commit: validating changed PHP files (npm run build:php:validate)…"

if ! npm run --silent build:php:validate; then
    echo ""
    echo "✘ pre-commit: PHP syntax error in a changed file."
    echo "  Fix the error above and re-stage, or bypass in an emergency with:"
    echo "  git commit --no-verify (justify in PR)."
    exit 1
fi

echo "✓ pre-commit: PHP syntax check passed."

echo "→ pre-commit: validating YAML files (node scripts/validate-yaml.js)…"

if ! node scripts/validate-yaml.js; then
    echo ""
    echo "✘ pre-commit: YAML validation failed in changed files."
    echo "  Fix the YAML errors above and re-stage, or bypass in an emergency with:"
    echo "  git commit --no-verify (justify in PR)."
    exit 1
fi

echo "✓ pre-commit: YAML validation passed."

# SQL validation for any .sql files being committed
SQL_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '\.sql$' | head -20)

if [ -n "$SQL_FILES" ]; then
    echo "→ pre-commit: validating SQL syntax in changed .sql files…"

    SQL_ERRORS=0
    for sql_file in $SQL_FILES; do
        if [ ! -f "$sql_file" ]; then
            continue
        fi

        # Check for matching parentheses
        open_parens=$(grep -o '(' "$sql_file" 2>/dev/null | wc -l)
        close_parens=$(grep -o ')' "$sql_file" 2>/dev/null | wc -l)
        if [ "$open_parens" -ne "$close_parens" ]; then
            echo "  ✘ $sql_file: Mismatched parentheses ($open_parens open, $close_parens close)"
            SQL_ERRORS=$((SQL_ERRORS + 1))
        fi

        # Check for trailing comma before semicolon
        if grep -E ',\s*;' "$sql_file" > /dev/null 2>&1; then
            echo "  ✘ $sql_file: Trailing comma before semicolon"
            SQL_ERRORS=$((SQL_ERRORS + 1))
        fi

        # Check for consecutive commas (,,) which indicate malformed tuples
        if grep -E ',\s*,' "$sql_file" > /dev/null 2>&1; then
            echo "  ✘ $sql_file: Consecutive commas detected (malformed tuple)"
            SQL_ERRORS=$((SQL_ERRORS + 1))
        fi

        # Check for INSERT without VALUES or SELECT
        if grep -q "^INSERT INTO" "$sql_file" 2>/dev/null; then
            if ! grep "INSERT INTO.*VALUES\|INSERT INTO.*SELECT" "$sql_file" > /dev/null 2>&1; then
                echo "  ✘ $sql_file: INSERT statement without VALUES or SELECT"
                SQL_ERRORS=$((SQL_ERRORS + 1))
            fi
        fi
    done

    if [ $SQL_ERRORS -gt 0 ]; then
        echo ""
        echo "✘ pre-commit: SQL validation failed ($SQL_ERRORS error(s))."
        echo "  Fix the SQL syntax errors above and re-stage, or bypass in an emergency with:"
        echo "  git commit --no-verify (justify in PR)."
        exit 1
    fi

    echo "✓ pre-commit: SQL syntax validation passed."
fi

exit 0
