<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    @page { margin: 18mm 16mm 16mm 16mm; }
    body { font-family: sans-serif; font-size: 11pt; color: #1a1a1a; line-height: 1.4; }
    h1 { font-size: 16pt; margin: 0 0 2mm 0; letter-spacing: 0.3px; }
    .letterhead { border-bottom: 0.4pt solid #1a1a1a; padding-bottom: 4mm; margin-bottom: 8mm; }
    .letterhead img { max-width: 50mm; max-height: 16mm; margin-bottom: 2mm; }
    .church-name { font-size: 14pt; font-weight: bold; }
    .muted { color: #555; font-size: 9.5pt; }
    .meta { margin: 6mm 0; }
    .recipient { margin: 6mm 0 8mm 0; }
    table.gifts { width: 100%; border-collapse: collapse; margin: 4mm 0 2mm 0; }
    table.gifts th { border-bottom: 0.6pt solid #1a1a1a; font-size: 9pt; text-transform: uppercase; letter-spacing: 0.4px; padding: 2mm 1.5mm; text-align: left; }
    table.gifts td { border-bottom: 0.2pt solid #ccc; padding: 2mm 1.5mm; font-size: 10pt; }
    .right { text-align: right; }
    .totals { width: 70mm; margin-left: auto; margin-top: 3mm; }
    .totals td { padding: 1.2mm 0; font-size: 10pt; }
    .totals .label { text-align: left; }
    .totals .amount { text-align: right; font-variant-numeric: tabular-nums; }
    .totals .final td { border-top: 0.6pt solid #1a1a1a; font-weight: bold; padding-top: 2mm; }
    .disclosure { margin-top: 8mm; font-size: 9.5pt; color: #333; }
    .closing { margin-top: 6mm; }
    .empty { margin: 6mm 0; font-style: italic; color: #555; }
  </style>
</head>
<body>
  {% block content %}{% endblock %}
</body>
</html>
