{% extends "_base.html.twig" %}
{% block content %}
  <style>
    .teachers { font-size: 10pt; margin: 0 0 1mm 0; }
    table.grid { width: 100%; border-collapse: collapse; margin: 3mm 0 4mm 0; }
    table.grid th, table.grid td { border: 0.4pt solid #333; padding: 0 0.8mm; text-align: center; font-size: 8pt; height: {{ with_pictures ? '10mm' : '6mm' }}; }
    table.grid th { font-weight: bold; background-color: #f2f2f2; height: 5.5mm; }
    table.grid th.title { text-align: left; font-size: 10pt; }
    table.grid td.name { text-align: left; font-size: 9pt; }
    table.grid td.photo { padding: 0; vertical-align: middle; }
    table.grid .closed { background-color: #c8c8c8; }
    table.grid tr.total td { font-weight: bold; }
  </style>
  {% set lead = with_pictures ? 2 : 1 %}
  {% for class in classes %}
    <h1>{{ class.name }} <span class="muted">{{ fiscal_year }}</span></h1>
    {% if class.teachers %}<p class="teachers"><b>{{ gettext('Teachers') }}:</b> {{ class.teachers }}</p>{% endif %}
    {% if class.liaisons %}<p class="teachers"><b>{{ gettext('Liaison') }}:</b> {{ class.liaisons }}</p>{% endif %}
    {% for table in class.tables %}
      {% if table.rows or table.extra > 0 %}
        <table class="grid" repeat_header="1">
          <thead>
            <tr>
              <th class="title" rowspan="2" colspan="{{ lead }}">{{ table.title }}</th>
              {% for month in months %}<th colspan="{{ month.span }}">{{ month.label }}</th>{% endfor %}
            </tr>
            <tr>
              {% for sunday in sundays %}<th class="{{ sunday.closed ? 'closed' : '' }}" style="width: {{ widths.day }}mm;">{{ sunday.day }}</th>{% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for person in table.rows %}
              <tr>
                {% if with_pictures %}<td class="photo" style="width: {{ widths.photo }}mm;">{% include '_person-photo.html.twig' with {'person': person} only %}</td>{% endif %}
                <td class="name" style="width: {{ widths.name }}mm;">{{ person.name }}</td>
                {% for sunday in sundays %}<td class="{{ sunday.closed ? 'closed' : '' }}"></td>{% endfor %}
              </tr>
            {% endfor %}
            {% if table.extra > 0 %}
              {% for i in 1..table.extra %}
                <tr>
                  {% if with_pictures %}<td class="photo"></td>{% endif %}
                  <td class="name"></td>
                  {% for sunday in sundays %}<td class="{{ sunday.closed ? 'closed' : '' }}"></td>{% endfor %}
                </tr>
              {% endfor %}
            {% endif %}
            <tr class="total">
              <td class="name" colspan="{{ lead }}">{{ gettext('Totals') }}</td>
              {% for sunday in sundays %}<td class="{{ sunday.closed ? 'closed' : '' }}"></td>{% endfor %}
            </tr>
          </tbody>
        </table>
      {% endif %}
    {% endfor %}
    {% if not loop.last %}<pagebreak />{% endif %}
  {% else %}
    <p class="empty">{{ gettext('No records were returned from the previous report. Please adjust your filters or date range and try again.') }}</p>
  {% endfor %}
{% endblock %}
