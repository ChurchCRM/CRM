{% extends "_letter.html.twig" %}
{% set show_tax_id = not canadian|default(false) %}
{% block letter_body %}
  {% if canadian|default(false) %}
    {% for family in families %}
      {% if not loop.first %}{% include "_letter-break.html.twig" %}{% endif %}
      <htmlpagefooter name="receipt-{{ loop.index }}"><div>{{ family.serial }} — {{ gettext('Page') }} {PAGENO}</div></htmlpagefooter>
      <sethtmlpagefooter name="receipt-{{ loop.index }}" value="on" show-this-page="1" />
      <div class="meta">
        <strong>{{ legal_name }}</strong><br>{{ registered_address|nl2br }}<br>
        {{ gettext('Registration Number') }}: {{ registration }}
        {% if sample|default(false) %}<h1>SAMPLE — NOT VALID FOR TAX PURPOSES</h1>{% endif %}
        <h1>{{ title }}</h1>
        <p>Official receipt for income tax purposes / Reçu officiel aux fins de l’impôt sur le revenu</p>
        <p>{{ gettext('Receipt No.') }}: {{ family.serial }}<br>
        {{ gettext('Gift Calendar Year') }}: {{ gift_year }}<br>
        {{ gettext('Issue Date') }}: {{ issue_date }}<br>
        {{ gettext('Issue Locality') }}: {{ locality }}<br>{{ gettext('Currency') }}: CAD</p>
        {% if duplicate %}<strong>Duplicate copy / Copie duplicata</strong>{% endif %}
      </div>
      <div class="recipient"><strong>{{ family.salutation }}</strong><br>{{ family.address|nl2br }}</div>
      <table class="gifts">
        <thead><tr><th>{{ gettext('Date received') }}</th><th>{{ gettext('Fund') }}</th><th>{{ gettext('Memo') }}</th><th class="right">{{ gettext('Amount (CAD)') }}</th></tr></thead>
        <tbody>{% for gift in family.gifts %}<tr><td>{{ gift.date }}</td><td>{{ gift.fund }}</td><td>{{ gift.memo }}</td><td class="right">{{ gift.amount }}</td></tr>{% endfor %}</tbody>
      </table>
      <p>{{ gettext('Amount of gifts') }}: {{ family.total }}<br>
      {{ gettext('Amount of advantages') }}: CAD 0.00 — None / Aucun<br>
      <strong>{{ gettext('Eligible amount of gifts for income tax purposes') }}: {{ family.total }}</strong></p>
      <div class="closing" style="page-break-inside: avoid;">
        {% if closing %}<p>{{ closing }}</p>{% endif %}
        {% if questions %}<p>{{ questions }}</p>{% endif %}
        <p>{{ sincerely }}</p>
        {% if signature %}<img src="{{ signature }}" style="max-width: 50mm; max-height: 20mm;" alt="{{ gettext('Authorized Signature') }}">{% else %}<p>{{ gettext('Sample signature placeholder') }}</p>{% endif %}
        <p>{{ signer }}</p>
        <p>Canada Revenue Agency — <a href="https://www.canada.ca/charities-giving">canada.ca/charities-giving</a></p>
      </div>
    {% endfor %}
  {% else %}

  {% for family in families %}
    {% if not loop.first %}{% include "_letter-break.html.twig" %}{% endif %}

    <div class="meta">
      <h1>{{ title|default(gettext('Giving Statement')) }}</h1>
      <div class="muted">{{ date_range }}</div>
    </div>

    <div class="recipient">
      <strong>{{ family.salutation }}</strong><br>
      {{ family.address|nl2br }}
      {% if family.envelope %}<br><span class="muted">{{ gettext('Envelope') }}: {{ family.envelope }}</span>{% endif %}
    </div>

    <p>{{ opening }}</p>

    {% if family.gifts is empty %}
      <p class="empty">{{ empty_message|default(gettext('No contributions were recorded for this period.')) }}</p>
    {% else %}
      <table class="gifts">
        <thead>
          <tr>
            <th>{{ gettext('Date') }}</th>
            <th>{{ gettext('Fund') }}</th>
            <th>{{ gettext('Method') }}</th>
            <th class="right">{{ gettext('Amount') }}</th>
          </tr>
        </thead>
        <tbody>
          {% for gift in family.gifts %}
            <tr>
              <td>{{ gift.date }}</td>
              <td>{{ gift.fund }}</td>
              <td>{{ gift.method }}</td>
              <td class="right">{{ gift.amount }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <table class="totals">
        <tr>
          <td class="label">{{ gettext('Total contributions') }}</td>
          <td class="amount">{{ family.total }}</td>
        </tr>
        <tr>
          <td class="label">{{ gettext('Goods and services') }}</td>
          <td class="amount">{{ family.goods_services }}</td>
        </tr>
        <tr class="final">
          <td class="label">{{ gettext('Tax-deductible amount') }}</td>
          <td class="amount">{{ family.deductible|default(family.total) }}</td>
        </tr>
      </table>
    {% endif %}

    {% set disclosure_text = family.disclosure is defined ? family.disclosure : disclosure %}
    {% if disclosure_text %}<p class="disclosure">{{ disclosure_text }}</p>{% endif %}

    <div class="closing">
      <p>{{ closing }}</p>
      {% if questions %}<p>{{ questions }}</p>{% endif %}
      {% if sincerely %}<p>{{ sincerely }},</p>{% endif %}
      {% if signer %}<p>{{ signer }}</p>{% endif %}
    </div>

    {% if remittance %}
      <div class="remittance">
        <p class="muted">{{ gettext('Please detach this slip and mail with your next gift.') }}</p>
        <p class="muted"><em>{{ gettext('Please mail your next gift to %s')|format(church_name) }}, {{ church_address }}{% if church_phone %}, {{ gettext('Phone') }}: {{ church_phone }}{% endif %}</em></p>
        <table>
          <tr>
            <td>
              <strong>{{ family.salutation }}</strong><br>
              {{ family.address|nl2br }}
            </td>
            <td>
              {{ gettext('Gift Amount') }}:<br><br>
              {{ gettext('Gift Designation') }}:
            </td>
            <td class="line">&nbsp;<br><br>&nbsp;</td>
          </tr>
        </table>
      </div>
    {% endif %}
  {% endfor %}
  {% endif %}
{% endblock %}
