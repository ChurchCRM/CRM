{% extends "_base.html.twig" %}
{% block content %}
  <style>
    body { font-family: serif; }
    h1.fundraiser { font-size: 16pt; margin: 0; }
    .fundraiser-description { font-size: 12pt; margin: 0 0 8mm 0; }
    h2.certificate { font-size: 34pt; margin: 0 0 10mm 0; }
    h3.item { font-size: 22pt; margin: 0 0 4mm 0; }
    .description { font-size: 14pt; }
  </style>
  {% for item in items %}
    <h1 class="fundraiser">{{ fundraiser_title }}</h1>
    <div class="fundraiser-description">{{ fundraiser_description }}</div>
    <h2 class="certificate">{{ gettext('Certificate of Ownership') }}</h2>
    <h3 class="item">{{ item.code }}: {{ item.title }}</h3>
    <div class="description">
      {{ item.description }}
      {% if item.estimate > 0 %}{{ gettext('Estimated value %s.')|format(item.estimate_text) }}{% endif %}
      {% if item.donor_last %}{{ gettext('Donated by %1$s %2$s.')|format(item.donor_first, item.donor_last) }}{% endif %}
    </div>
    {% if not loop.last %}<pagebreak />{% endif %}
  {% else %}
    <p class="empty">{{ gettext('No records were returned from the previous report. Please adjust your filters or date range and try again.') }}</p>
  {% endfor %}
{% endblock %}
