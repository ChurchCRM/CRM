{% extends "_base.html.twig" %}
{% block content %}
  <div class="letterhead">
    {% if letterhead == 'graphic' and letterhead_image %}
      <img src="{{ letterhead_image }}" alt="" style="max-width: 170mm; max-height: 28mm;">
    {% elseif church_logo %}
      <img src="{{ church_logo }}" alt="">
    {% endif %}
    <div class="church-name">{{ church_name }}</div>
    <div class="church-address">{{ church_address }}</div>
    {% if letterhead != 'none' %}
      <div class="muted">{{ church_phone }}{% if church_email %} · {{ church_email }}{% endif %}</div>
      {% if church_website or church_social %}
        <div class="muted">
          {% if church_website %}<a href="{{ church_website }}">{{ church_website }}</a>{% endif %}
          {% for link in church_social %}{% if church_website or not loop.first %} · {% endif %}<a href="{{ link.url }}">{{ link.label }}</a>{% endfor %}
        </div>
      {% endif %}
    {% endif %}
  </div>
  {% block letter_body %}{% endblock %}
  {% if generated_on %}
    <div class="generated">{{ gettext('Generated') }} {{ generated_on }}</div>
  {% endif %}
{% endblock %}
