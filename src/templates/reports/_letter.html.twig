{% extends "_base.html.twig" %}
{% block content %}
  <div class="letterhead">
    {% if church_logo %}
      <img src="{{ church_logo }}" style="max-width: 60mm; max-height: 20mm;">
    {% endif %}
    {% if letterhead != 'none' %}
      <strong>{{ church_name }}</strong><br>
      {{ church_address }}<br>
      <span class="muted">{{ church_phone }} {{ church_email }}</span>
    {% endif %}
  </div>
  <div style="margin-top: 8mm;">
    {% block letter_body %}{% endblock %}
  </div>
{% endblock %}
