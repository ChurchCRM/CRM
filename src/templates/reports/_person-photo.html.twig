{% if person.photo %}<img src="{{ person.photo }}" alt="" style="width: 8mm; height: 8mm;">{% else %}<table style="width: 8mm; height: 8mm; background-color: #e9ecef;"><tr><td style="width: 8mm; height: 8mm; padding: 0; border: 0; text-align: center; vertical-align: middle; color: #6c757d; font-size: 9pt;">{{ person.initials }}</td></tr></table>{% endif %}
