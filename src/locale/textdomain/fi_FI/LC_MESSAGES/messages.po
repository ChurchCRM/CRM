msgstr[0] "%d uusi tapahtumakerta"
msgstr[1] "%d uutta tapahtumakertaa"

#: 
msgid "%d volunteer is still needed for an upcoming occurrence."
msgid_plural "%d volunteers are still needed for an upcoming occurrence."
msgstr[0] "Tulevalle tapahtumakerralle tarvitaan vielä %d vapaaehtoinen."
msgstr[1] "Tuleville tapahtumakerroille tarvitaan vielä %d vapaaehtoista."

#: 
msgid "%s Calendar"
msgstr "%s-kalenteri"

#: 
msgid "%s Family"
msgstr "Perhe %s"

#: 
msgid "%s does not provide teachers for Sunday School, so its teams, schedules and events cannot use a class. A volunteer manager can change that under Edit ministry."
msgstr "%s ei tarjoa opettajia pyhäkouluun, joten sen tiimit, aikataulut ja tapahtumat eivät voi käyttää luokkaa. Vapaaehtoisvastaava voi muuttaa tämän kohdassa Muokkaa työalaa."

#: 
msgid "%s email from the church"
