msgstr "Саморєстрацію вимкнено"

#: 
msgid "Self-registration is enabled"
msgstr "Саморєстрацію ввімкнено"

#: 
msgid "The public registration form is turned off. Existing registrations are listed below."
msgstr "Загальнодоступну форму реєстрації вимкнено. Наявні реєстрації наведено нижче."

#: 
msgid "This family is not a pending self-registration"
msgstr "Ця родина не очікує перевірки саморєстрації"

#: 
msgid "This person belongs to a family — approve the family instead"
msgstr "Ця особа належить до родини — схваліть натомість усю родину"

#: 
msgid "This person is not a pending self-registration"
msgstr "Ця особа не очікує перевірки саморєстрації"

#: 
msgid "This self-registered family is pending review"
msgstr "Ця саморєстрована родина очікує перевірки"

#: 
msgid "Total registrations"
msgstr "Усього реєстрацій"

#: 
msgid "Visitors can sign up on your public registration form."
msgstr "Відвідувачі можуть зареєструватися через вашу загальнодоступну форму реєстрації."

#: 
msgid "Yesterday"
msgstr "Учора"

#: 
msgid "days ago"
msgstr "дн. тому"

#: 
msgid "self-registrations are waiting for review"
msgstr "саморєстрацій очікують перевірки"

#: 
msgid "Birthdays are addressed to the person and anniversaries to the couple."
msgstr "Вітання з днем народження адресуються особі, а з річницею — подружжю."

#: 
msgid "Mailing labels for the people in this report. A person with no address of their own is addressed at their family address."
msgstr "Поштові наклейки для людей із цього звіту. Якщо в особи немає власної адреси, використовується адреса її родини."

#: 
msgid "One label for each couple."
msgstr "Одна наклейка на кожну пару."

#: 
msgid "Print Labels"
msgstr "Друк наклейок"

#: 
msgid "That role is not one of this group's roles."
msgstr "Ця роль не входить до ролей цієї групи."

#: 
msgid "\"%s\" is not a kind of calendar this page knows about."
msgstr "«%s» — невідомий цій сторінці вид календаря."

#: 
msgid "%1$s cannot serve and has proposed %2$s as a substitute."
msgstr "%1$s не може служити і запропонував(ла) %2$s як заміну."

#: 
msgid "%1$s is already in the %2$s volunteer pool and wants to help again."
msgstr "%1$s уже в резерві волонтерів «%2$s» і хоче допомагати знову."

#: 
msgid "%1$s is already linked to %2$s in %3$s"
msgstr "%1$s уже пов’язаний(а) з %2$s у %3$s"

#: 
msgid "%1$s is in %2$s as %3$s. Remove them from the class first; qualifying them here then makes them one of its teachers."
msgstr "%1$s перебуває в %2$s як %3$s. Спершу вилучіть особу з класу; після надання кваліфікації тут вона стане одним із його вчителів."

#: 
msgid "%1$s is not an event of %2$s"
msgstr "%1$s не є подією %2$s"

#: 
msgid "%1$s stays a Sunday School class while its teachers are managed in Ministries → %2$s → %3$s. Unlink it from the team first."
msgstr "%1$s залишається класом недільної школи, доки його вчителями керують у розділі «Служіння» → %2$s → %3$s. Спершу відв’яжіть його від команди."

#: 
msgid "%1$s wants to help with %2$s"
msgstr "%1$s хоче допомагати в «%2$s»"

#: 
msgid "%1$s wants to help with %2$s and has been added to its volunteer pool."
msgstr "%1$s хоче допомагати в «%2$s» і доданий(а) до його резерву волонтерів."

#: 
msgid "%1$s: Max is %2$d but %3$d default volunteers are chosen. Remove one or raise Max."
msgstr "%1$s: максимум %2$d, але вибрано волонтерів за замовчуванням: %3$d. Приберіть зайвих або збільште максимум."

#: 
msgid "%d day"
msgid_plural "%d days"
msgstr[0] "%d день"
msgstr[1] "%d дні"
msgstr[2] "%d днів"
msgstr[3] "%d дня"

#: 
msgid "%d default skipped for another reason (the occurrence is over, cancelled or full)"
