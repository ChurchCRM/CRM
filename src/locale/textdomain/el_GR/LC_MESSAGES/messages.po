msgstr "Η σύνδεση είναι απενεργοποιημένη"

#: 
msgid "Sign-in is disabled for this person."
msgstr "Η σύνδεση είναι απενεργοποιημένη για αυτό το άτομο."

#: 
msgid "Sign-in is enabled for this person."
msgstr "Η σύνδεση είναι ενεργοποιημένη για αυτό το άτομο."

#: 
msgid "Sign-in is not disabled for this person."
msgstr "Η σύνδεση δεν είναι απενεργοποιημένη για αυτό το άτομο."

#: 
msgid "Sign-in refused"
msgstr "Η σύνδεση απορρίφθηκε"

#: 
msgid "Sign-in, sessions and the API key are blocked until this is resolved on the linked person's record."
msgstr "Η σύνδεση, οι συνεδρίες και το κλειδί API αποκλείονται μέχρι να διευθετηθεί αυτό στην καρτέλα του συνδεδεμένου ατόμου."

#: 
msgid "Signed in, last 30 days"
msgstr "Συνδέθηκαν, τελευταίες 30 ημέρες"

#: 
msgid "Signed out"
msgstr "Αποσυνδέθηκε"

#: 
