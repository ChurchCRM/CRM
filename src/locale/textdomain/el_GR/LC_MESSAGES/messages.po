msgstr "{{name}} ({{count}} επερχόμενα)"

#: 
msgid "{{name}} does not name the event it follows, so it has nothing to staff."
msgstr "Το {{name}} δεν ονομάζει το γεγονός που ακολουθεί, οπότε δεν υπάρχει κάτι για στελέχωση."

#: 
