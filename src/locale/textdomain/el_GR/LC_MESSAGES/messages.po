#: 
msgid "Show the member directory"
msgstr "Εμφάνιση του καταλόγου μελών"

#: 
msgid "Show the member directory in the Member Portal."
msgstr "Εμφάνιση του καταλόγου μελών στην Πύλη μελών."

#: 
