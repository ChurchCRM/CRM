#: 
msgid "{{name}} is no longer qualified, so this place is left open on new occurrences."
msgstr "Το {{name}} δεν είναι πλέον κατάλληλο, οπότε αυτή η θέση μένει ανοιχτή στις νέες εμφανίσεις."

#: 
msgid "{{name}} starts on {{date}}, after the dates generated now (through {{through}})."
msgstr "Το {{name}} αρχίζει στις {{date}}, μετά τις ημερομηνίες που δημιουργούνται τώρα (έως {{through}})."

#: 
msgid "{{pending}} not yet confirmed"
msgstr "{{pending}} δεν έχουν ακόμη επιβεβαιωθεί"

#: 
msgid "{{position}}: Max is {{max}} but {{chosen}} default volunteers are chosen. Remove one or raise Max."
msgstr "{{position}}: το μέγιστο είναι {{max}}, αλλά έχουν επιλεγεί {{chosen}} προεπιλεγμένοι εθελοντές. Αφαιρέστε έναν ή αυξήστε το μέγιστο."

#: 
