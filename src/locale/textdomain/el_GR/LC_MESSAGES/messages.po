msgstr "Στείλτε τα πεδία προς εμφάνιση ως αντικείμενο τιμών true και false."

#: 
msgid "Send the settings as a JSON object."
msgstr "Στείλτε τις ρυθμίσεις ως αντικείμενο JSON."

#: 
