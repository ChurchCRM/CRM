msgstr "Een bezettingsbehoefte vermeldt de standaardvrijwilligers in \"defaults\": [{personId, accepted}]"

#: 
msgid "A staffing requirement belongs to exactly one of a schedule or an occurrence"
msgstr "Een bezettingsvereiste hoort bij precies één van een rooster of een moment"

