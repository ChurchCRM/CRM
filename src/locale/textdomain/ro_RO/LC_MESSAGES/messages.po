msgstr "{{created}} ocurențe create, {{existing}} existau deja"

#: 
msgid "{{ministry}} created {{total}} events for {{className}} ({{upcoming}} upcoming)."
msgstr "{{ministry}} a creat {{total}} evenimente pentru {{className}} ({{upcoming}} viitoare)."

#: 
msgid "{{names}} also staff some of them."
msgstr "{{names}} asigură personal și pentru unele dintre ele."

#: 
msgid "{{name}} already coordinates this ministry"
msgstr "{{name}} coordonează deja această slujire"

#: 
msgid "{{name}} assigned"
