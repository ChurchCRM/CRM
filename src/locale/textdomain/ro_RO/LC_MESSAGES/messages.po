msgid "{{position}}: the maximum cannot be below the minimum."
msgstr "{{position}}: maximul nu poate fi sub minim."

#: 
msgid "{{position}}: {{name}} no longer qualified"
msgstr "{{position}}: {{name}} nu mai este calificat"

#: 
msgid "{{position}}: {{name}} qualified"
msgstr "{{position}}: {{name}} calificat"

#: 
msgid "{{proposer}} asks {{substitute}} to take their place"
msgstr "{{proposer}} îi cere lui {{substitute}} să-i ia locul"

#: 
msgid "{{title}} on {{date}} created. Staff it now?"
msgstr "{{title}} din {{date}} a fost creat. Asigurați-i personal acum?"

