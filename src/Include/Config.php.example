<?php
/**
 * ChurchCRM configuration. LoadConfigs.php (required at the bottom) loads and validates it.
 *
 * The setup wizard writes this file. To write it by hand instead:
 * - Copy Config.php.example to Config.php and replace each ||PLACEHOLDER|| value below
 * - Values are single-quoted PHP strings: write \' for a ' and \\ for a \ (the wizard does this for you)
 * - Test by opening ChurchCRM: a setting or database problem shows a page that says which
 * - Help: https://docs.churchcrm.io/installation/database-setup-troubleshooting
 */

// ============================================================================
// DATABASE CONNECTION
// ============================================================================

// Database server address from your web host.
// In Docker, use the database service name (db in the official compose file), not localhost.
$sSERVERNAME = '||DB_SERVER_NAME||';

// Database server port, usually 3306 (also used when blank).
// Ignored when the server is localhost: PHP then uses the MySQL socket.
$dbPort = '||DB_SERVER_PORT||';

// Database user. It needs ALL PRIVILEGES on this database only; upgrades create, alter and drop tables.
$sUSER = '||DB_USER||';

// Database password. It cannot be empty. Keep it inside the single quotes.
$sPASSWORD = '||DB_PASSWORD||';

// Database name. Create the database first: ChurchCRM creates its tables, not the database.
$sDATABASE = '||DB_NAME||';

// ============================================================================
// WEB ADDRESS
// ============================================================================

// Path ChurchCRM is installed under: '' at the site root, or a path starting with / and no trailing slash.
// - https://www.mychurch.org/churchcrm/  ->  '/churchcrm'
// - https://crm.mychurch.org/            ->  ''
$sRootPath = '||ROOT_PATH||';

// Full web address, starting with http:// or https:// and ending with a slash. Use https:// in production.
$URL[0] = '||URL||';

// Only fatal PHP errors are reported. See https://www.php.net/manual/en/errorfunc.constants.php
error_reporting(E_ERROR);

// ||WIZARD_INSTALL||

// Do not change below this line.
require_once(dirname(__FILE__) . DIRECTORY_SEPARATOR . 'LoadConfigs.php');
