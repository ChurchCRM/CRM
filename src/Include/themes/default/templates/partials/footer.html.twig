{#
  The portal footer: how to reach the church on the left, and the church's own
  social accounts (#9907) on the right. Both sides come from Admin → Church
  Information; nothing is hard-coded here, and a side with nothing configured
  renders nothing at all.
#}
<footer class="portal-footer">
    <div class="portal-container portal-footer-inner">
        <div class="portal-footer-church">
            <span class="portal-footer-church-name">{{ church.name }}</span>
            {% if church.phone %}<span class="portal-footer-detail">{{ church.phone }}</span>{% endif %}
            {% if church.email %}
            <a class="portal-footer-detail" href="mailto:{{ church.email }}">{{ church.email }}</a>
            {% endif %}
            {% if church.website %}
            <a class="portal-footer-detail" href="{{ church.website }}" rel="noopener noreferrer">{{ gettext('Church website') }}</a>
            {% endif %}
        </div>
        {% if church.socialLinks is not empty %}
        <div class="portal-footer-social">
            {% for link in church.socialLinks %}
            <a class="portal-footer-social-link"
               href="{{ link.url }}"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="{{ link.label }}"
               title="{{ link.label }}"><i class="{{ link.icon }}" aria-hidden="true"></i></a>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</footer>
