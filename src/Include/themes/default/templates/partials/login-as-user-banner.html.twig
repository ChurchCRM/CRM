{#
  Login as User (member sign-in design §6.5): an administrator is seeing the
  portal as this member. It says so on every page, says whether changes are
  allowed, and holds Stop, the only way back to the staff side.
#}
{% if portal.loginAsUser %}
<div class="portal-login-as-user" id="login-as-user-banner" role="status">
    <div class="portal-login-as-user-inner">
        <i class="fa-solid fa-user-secret portal-login-as-user-icon" aria-hidden="true"></i>
        <p class="portal-login-as-user-text">
            <strong>{{ gettext('You are logged in as %s.')|format(portal.loginAsUser.personName) }}</strong>
            {% if portal.loginAsUser.allowsChanges %}
                <span id="login-as-user-changes">{{ gettext('Changes are allowed, and each one is recorded with your name.') }}</span>
            {% else %}
                <span id="login-as-user-changes">{{ gettext('Changes are turned off.') }}</span>
            {% endif %}
            {{ gettext('Staff pages stay closed until you press Stop.') }}
        </p>
        <form method="post" action="{{ portal.loginAsUser.stopUrl }}" class="portal-login-as-user-stop">
            {{ csrf_field() }}
            <button type="submit" class="portal-button" id="login-as-user-stop">
                <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>{{ gettext('Stop') }}
            </button>
        </form>
    </div>
</div>
{% endif %}
