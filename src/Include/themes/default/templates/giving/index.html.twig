{% extends "layouts/page.html.twig" %}
{% block content %}
<div class="card">
  <div class="card-header">
    <h3 class="card-title">{{ pageTitle }}</h3>
  </div>
  <div class="card-body">
    <p class="text-secondary">
      {% if isHousehold %}
        {{ "This is the household statement. It includes gifts for your family."|trans }}
      {% else %}
        {{ "This statement includes only gifts credited to you."|trans }}
      {% endif %}
    </p>
    <form method="get" action="{{ rootPath }}/portal/giving/statement">
      <div class="mb-3 col-6 col-md-3">
        <label class="form-label" for="year">{{ "Year"|trans }}</label>
        <input class="form-control" type="number" name="year" id="year" value="{{ year }}">
      </div>
      <button type="submit" class="btn btn-primary">{{ "Download statement"|trans }}</button>
    </form>
  </div>
</div>
{% endblock %}
