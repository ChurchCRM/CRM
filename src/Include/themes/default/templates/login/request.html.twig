{% extends "layout.html.twig" %}

{#
  Member sign-in: the email form at GET /portal/login (member sign-in design
  §6.1, §7). It posts to `loginUrl`; the answer is the code page, whatever the
  address.

  With `passkeySignIn` (passkeys on, and this site address can use them) it
  also offers a passkey (§6.3): a button, and the browser's passkey autofill
  on the email box. portal-passkeys.min.js shows them when the browser can,
  and posts the passkey's answer in `#portalPasskeyForm`.

  Variables: `pageTitle`, `email`, `emailError`, `loginUrl`, `passkeySignIn`,
  `selfRegistrationEnabled`, `guestPage`.
#}

{% block nav %}{% endblock %}

{% block content %}
<div class="portal-signin">
    <div class="portal-signin-welcome">
        <h1 class="portal-signin-title">{{ gettext('Welcome') }}</h1>
        <p class="portal-signin-lead">{{ gettext('Sign in to see your family, the church calendar and ways to serve. You do not need a password or an account.') }}</p>
    </div>

    <form class="portal-card portal-form" id="portalSignInForm" data-submit-once method="post" action="{{ loginUrl }}" novalidate>
        {{ csrf_field() }}

        <div class="portal-field">
            <label class="portal-field-label" for="portalSignInEmail">{{ gettext('Email Address') }}</label>
            <input class="portal-input{% if emailError %} is-invalid{% endif %}" type="email" name="email" id="portalSignInEmail"
                   value="{{ email }}" autocomplete="{{ passkeySignIn ? 'username webauthn' : 'email' }}" inputmode="email" autocapitalize="none" autocorrect="off" spellcheck="false"
                   placeholder="{{ gettext('name@example.com') }}" aria-describedby="portalSignInHint portalSignInEmailError" maxlength="254" required autofocus>
            <p class="portal-field-hint" id="portalSignInHint">{{ gettext('We will email you a code and a link to sign in with.') }}</p>
            <p class="portal-field-error" id="portalSignInEmailError" role="alert">{{ emailError }}</p>
        </div>

        <div class="portal-form-actions">
            <button class="portal-button" type="submit" id="portalSignInSubmit" data-busy-label="{{ gettext('Sending…') }}">{{ gettext('Email me a code') }}</button>
        </div>

        {% if passkeySignIn %}
        <div class="portal-passkey-signin" id="portalPasskeySignIn" data-passkey-sign-in data-options-url="{{ loginUrl }}/passkey/options" hidden>
            <p class="portal-signin-or" aria-hidden="true"><span>{{ gettext('or') }}</span></p>
            <div class="portal-form-actions">
                <button class="portal-button portal-button-quiet" type="button" id="portalPasskeySignInButton">
                    <i class="fa-solid fa-key" aria-hidden="true"></i>
                    <span>{{ gettext('Sign in with a passkey') }}</span>
                </button>
            </div>
            <p class="portal-field-error" id="portalPasskeySignInError" data-passkey-error role="alert"></p>
        </div>
        {% endif %}
    </form>

    {% if passkeySignIn %}
    <form id="portalPasskeyForm" method="post" action="{{ loginUrl }}/passkey" hidden>
        {{ csrf_field() }}
        <input type="hidden" name="credentialId">
        <input type="hidden" name="clientDataJSON">
        <input type="hidden" name="authenticatorData">
        <input type="hidden" name="signature">
        <input type="hidden" name="userHandle">
    </form>
    {% endif %}

    {% if church.email or church.phone %}
    <p class="portal-signin-help">
        {{ gettext('Not sure which email we have? Contact the church office.') }}
        {% if church.phone %}<a href="tel:{{ church.phone }}">{{ church.phone }}</a>{% endif %}
        {% if church.email %}<a href="mailto:{{ church.email }}">{{ church.email|email_wrap }}</a>{% endif %}
    </p>
    {% endif %}
</div>
{% endblock %}

{% block scripts_extra %}
{% if passkeySignIn %}
<script src="{{ asset('/skin/v2/portal-passkeys.min.js') }}"></script>
{% endif %}
{% endblock %}
