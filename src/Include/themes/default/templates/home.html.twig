{% extends "layout.html.twig" %}

{#
  The member's landing page. MP2 shipped the welcome card and a clearly-marked
  placeholder for each section a later issue fills in, so a church that installs
  this release sees what is coming rather than an empty page. My Family and
  Profile are real cards since MP4; only the calendar is still a placeholder.

  MP6 (#9867) makes the volunteering card real: its two lines — what the member
  is on for next, and how many of their assignments are still waiting for an
  answer — are filled in by `portal.min.js` from `/api/volunteer/me/assignments`.
  The card is server-rendered empty and stays useful if that request fails.

  Variables: `pageTitle`, `showVolunteering` (whether the volunteering card is
  rendered at all), `familySummary` (`{name, memberCount}`, or null when the
  member has no family record).
#}

{% macro placeholder_card(icon, title, id) %}
<section class="portal-card portal-card-placeholder{% if id %} portal-card-{{ id }}{% endif %}">
    <h2 class="portal-card-title">
        <i class="{{ icon }}" aria-hidden="true"></i>
        <span>{{ title }}</span>
    </h2>
    <p class="portal-placeholder-badge">{{ gettext('Coming soon') }}</p>
    <p class="portal-card-text">
        {{ gettext('This part of the Member Portal is not ready yet. It will appear here in a future update.') }}
    </p>
</section>
{% endmacro %}

{% block content %}
{% import _self as cards %}
<div class="portal-home">

    <section class="portal-card portal-welcome">
        <h1 class="portal-welcome-title">{{ gettext('Welcome, %s')|format(member.firstName|default(member.fullName)) }}</h1>
        {% if member.familyName %}
        <p class="portal-welcome-family">{{ gettext('%s family')|format(member.familyName) }}</p>
        {% endif %}
        <p class="portal-welcome-intro">
            {{ gettext('This is your church account. Everything you can do for yourself and your family lives here.') }}
        </p>
    </section>

    <div class="portal-card-grid">
        {#
          The section switches on Admin → Member Portal (#9864) decide whether
          a section belongs on the page at all. `id` is what the switch is
          named after, so a theme overriding this page can filter the same way.
          Only the calendar is still a placeholder: MP6 made volunteering a
          real card below, behind its own `showVolunteering`.
        #}
        {% set placeholders = [
            { 'id': 'calendar', 'icon': 'fa-solid fa-calendar-days', 'title': gettext('Church calendar'), 'shown': portal.showCalendar }
        ]|filter(placeholder => placeholder.shown) %}
        {% for placeholder in placeholders %}
        {{ cards.placeholder_card(placeholder.icon, placeholder.title, placeholder.id) }}
        {% endfor %}

        {% if showVolunteering %}
        <section class="portal-card portal-card-volunteering" id="portal-volunteering-card">
            <h2 class="portal-card-title">
                <i class="fa-solid fa-handshake-angle" aria-hidden="true"></i>
                <span>{{ gettext('My volunteering') }}</span>
            </h2>

            <p class="portal-card-text" id="portal-volunteering-loading">{{ gettext('Loading') }}</p>

            {# Filled by portal.min.js; the strings it writes are i18next.t() there. #}
            <p class="portal-card-text d-none" id="portal-volunteering-next"></p>
            <p class="portal-volunteering-pending d-none" id="portal-volunteering-pending"></p>

            <p class="portal-card-text d-none" id="portal-volunteering-empty">
                {{ gettext('Nothing on your list yet. Have a look at what needs filling.') }}
            </p>

            <a class="portal-card-link" href="{{ url('/portal/volunteer/schedule') }}">
                {{ gettext('Go to my volunteering') }}
            </a>
        </section>
        {% endif %}

        <section class="portal-card" id="portal-home-family-card">
            <h2 class="portal-card-title">
                <i class="fa-solid fa-people-roof" aria-hidden="true"></i>
                <span>{{ gettext('My Family') }}</span>
            </h2>
            {% if familySummary %}
            <p class="portal-card-text">
                <span class="portal-card-lead">{{ gettext('%s family')|format(familySummary.name) }}</span><br>
                {{ ngettext('%s person in your household', '%s people in your household', familySummary.memberCount)|format(familySummary.memberCount) }}
            </p>
            <p><a class="portal-card-link" href="{{ url('/portal/family') }}">{{ gettext('Update your details') }}</a></p>
            {% else %}
            <p class="portal-card-text">{{ gettext('You are not part of a family record yet.') }}</p>
            {% endif %}
        </section>

        <section class="portal-card" id="portal-home-profile-card">
            <h2 class="portal-card-title">
                <i class="fa-solid fa-user" aria-hidden="true"></i>
                <span>{{ gettext('Profile') }}</span>
            </h2>
            <p class="portal-card-text">
                <span class="portal-card-lead">{{ member.fullName }}</span><br>
                {{ gettext('Your name, email, phone numbers and photo.') }}
            </p>
            <p><a class="portal-card-link" href="{{ url('/portal/profile') }}">{{ gettext('Update your details') }}</a></p>
        </section>
    </div>

</div>
{% endblock %}
