{% extends "layout.html.twig" %}

{#
  Change your password, in the portal's layout.

  The portal's own page, GET/POST /portal/profile/password, for every role — a
  member, staff, an administrator, and during a masquerade. The same template
  also draws the forced first-login change at /v2/user/current/changepassword
  for a self-service session, which is why the form's target is a variable:
  each route posts back to itself (issue #9865).

  The field names, the form id and the CSRF form id are the ones the existing
  handler and skin/js/PasswordChange.js already expect — this is the same form
  in different clothes, not a second one.

  Variables: `formAction`, `minPasswordLength`, `oldPasswordError`,
  `newPasswordError`.
#}

{% block content %}
<div class="portal-password">

    <form class="portal-card portal-form" id="passwordChangeForm" method="post"
          action="{{ formAction|default(url('/portal/profile/password')) }}">
        {{ csrf_field() }}

        <h1 class="portal-page-title">{{ gettext('Change your password') }}</h1>
        <p class="portal-card-text">
            {{ gettext('Enter your current password, then your new password twice.') }}
            {{ ngettext('Passwords must be at least %s character long.', 'Passwords must be at least %s characters long.', minPasswordLength)|format(minPasswordLength) }}
        </p>

        <div class="portal-field">
            <label class="portal-field-label" for="OldPassword">{{ gettext('Current Password') }}</label>
            <input class="portal-input" type="password" name="OldPassword" id="OldPassword"
                   autocomplete="current-password" autofocus>
            {% if oldPasswordError %}
            <p class="portal-field-error" id="oldPasswordError" role="alert">{{ oldPasswordError }}</p>
            {% endif %}
        </div>

        <div class="portal-field">
            <label class="portal-field-label" for="NewPassword1">{{ gettext('New Password') }}</label>
            <input class="portal-input" type="password" name="NewPassword1" id="NewPassword1"
                   autocomplete="new-password">
        </div>

        <div class="portal-field">
            <label class="portal-field-label" for="NewPassword2">{{ gettext('Confirm New Password') }}</label>
            <input class="portal-input" type="password" name="NewPassword2" id="NewPassword2"
                   autocomplete="new-password">
            <p class="portal-field-error" id="NewPasswordError" role="alert">{{ newPasswordError }}</p>
        </div>

        <div class="portal-form-actions">
            <button class="portal-button" type="submit" name="Submit">{{ gettext('Save changes') }}</button>
            <a class="portal-button portal-button-quiet" href="{{ url('/portal/profile') }}">{{ gettext('Cancel') }}</a>
        </div>
    </form>

</div>
{% endblock %}

{% block scripts_extra %}
<script src="{{ asset('/skin/js/PasswordChange.js') }}"></script>
{% endblock %}
