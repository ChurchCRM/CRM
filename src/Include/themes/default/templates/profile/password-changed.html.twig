{% extends "layout.html.twig" %}

{#
  Shown after a successful password change made from the portal
  (POST /portal/profile/password, any role; also POST
  /v2/user/current/changepassword for a self-service session).
#}

{% block content %}
<section class="portal-card" id="portal-password-changed">
    <h1 class="portal-page-title">
        <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
        {{ gettext('Password Changed') }}
    </h1>
    <p class="portal-card-text">{{ gettext('Your password has been updated successfully.') }}</p>
    <p class="portal-action-row">
        <a class="portal-button" href="{{ url('/portal/profile') }}">{{ gettext('Back to your profile') }}</a>
    </p>
</section>
{% endblock %}
