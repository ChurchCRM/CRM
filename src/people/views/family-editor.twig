<form method="post" action="{{ formAction }}" id="familyEditor">
    {{ csrf_input() }}    <input type="hidden" name="famCount" value="{{ iFamilyMemberRows }}">
    <input type="hidden" id="stateType" name="stateType" value="">
    <input type="hidden" id="secondStateType" name="secondStateType" value="">

    {% if bErrorFlag %}
    <div class="alert alert-danger alert-dismissable" role="alert">
        <i class="fa-solid fa-ban me-2"></i>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        {{ gettext('Invalid fields or selections. Changes not saved! Please correct and try again!') }}    </div>
    {% endif %}

    <!-- Card 1: Family Info -->
    <div class="card clearfix">
        <div class="card-header d-flex align-items-center">
            <h3 class="card-title">{{ gettext('Family Info') }}</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="mb-3 col-12 col-md-6">
                    <label for="FamilyName">{{ gettext('Family Name') }}:</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-people-roof"></i></span>
                        <input type="text" name="name" id="FamilyName" value="{{ sName }}" maxlength="48" class="form-control">
                    </div>
                    {% if sNameError %}
                        <span class="text-danger small">{{ sNameError }}</span>
                    {% endif %}
                </div>
                {% if (not config_bool('bHideWeddingDate')) %}
{% if (dWeddingDate is empty) %}
{% set dWeddingDate = '' %}
{% endif %}
                <div class="mb-3 col-12 col-sm-6 col-md-4">
                    <label for="WeddingDate">{{ gettext('Wedding Date') }}:</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-heart"></i></span>
                        <input type="text" class="form-control date-picker" name="weddingDate" id="WeddingDate" value="{{ date_picker(dWeddingDate) }}" maxlength="12" placeholder="{{ date_picker_js_format() }}">
                    </div>
                    {% if sWeddingDateError %}
                    <span class="text-danger small">{{ sWeddingDateError }}</span>
                    {% endif %}
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Card 2: Location & Contact Information -->
    <div class="card clearfix">
        <div class="card-header d-flex align-items-center">
            <h3 class="card-title">{{ gettext('Location & Contact Information') }}</h3>
        </div>
        <div class="card-body">
            <!-- Location Section -->
            <div class="row">
                <div class="col-12">
                    <h5 class="text-body-secondary mb-3">{{ gettext('Address') }}</h5>
                </div>
            </div>
            <div class="row">
                <div class="mb-3 col-12 col-md-6">
                    <label for="Address1">{{ gettext('Address') }} 1:</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-location-dot"></i></span>
                        <input type="text" id="Address1" name="address1" value="{{ sAddress1 }}" maxlength="250" class="form-control">
                    </div>
                </div>
                <div class="mb-3 col-12 col-md-6">
                    <label for="Address2">{{ gettext('Address') }} 2:</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-location-dot"></i></span>
                        <input type="text" id="Address2" name="address2" value="{{ sAddress2 }}" maxlength="250" class="form-control">
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="mb-3 col-12 col-sm-6 col-md-4">
                    <label for="City">{{ gettext('City') }}:</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-city"></i></span>
                        <input type="text" id="City" name="city" value="{{ sCity }}" maxlength="50" class="form-control">
                    </div>
                </div>
                <div id="stateOptionDiv" class="mb-3 col-12 col-sm-6 col-md-3">
                    <label for="State">{{ gettext('State') }}:</label>
                    <select id="State" name="state" class="form-select" data-user-selected="{{ sState }}" data-system-default="{{ config_attr('sDefaultState') }}">
                    </select>
                </div>
                <div id="stateInputDiv" class="mb-3 col-12 col-sm-6 col-md-3 d-none">
                    <label for="StateTextbox">{{ gettext('State') }}:</label>
                    <input id="StateTextbox" type="text" class="form-control" name="stateTextbox" value="{{ sState }}" maxlength="30">
                </div>
                <div class="mb-3 col-12 col-sm-6 col-md-2">
                    <label for="Zip">{{ gettext('Zip') }}:</label>
                    <input type="text" id="Zip" name="zip" class="form-control{{ (config_bool('bForceUppercaseZip') ? ' text-uppercase' : '') }}" value="{{ sZip }}"  maxlength="10">
                </div>
                <div class="mb-3 col-12 col-sm-6 col-md-3">
                    <label for="Country">{{ gettext('Country') }}:</label>
                    <select id="Country" name="country" class="form-select" data-user-selected="{{ sCountry }}" data-system-default="{{ config_attr('sDefaultCountry') }}">
                    </select>
                </div>
            </div>
            {% if (not config_bool('bHideLatLon')) %}
                    <div class="row">
                        <div class="mb-3 col-12 col-sm-6 col-md-3">
                            <label for="Latitude">{{ gettext('Latitude') }}:</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-globe"></i></span>
                                <input type="text" class="form-control" id="Latitude" name="latitude" value="{{ ((nLatitude and (nLatitude is not same as(0))) ? nLatitude : '') }}" maxlength="50">
                            </div>
                        </div>
                        <div class="mb-3 col-12 col-sm-6 col-md-3">
                            <label for="Longitude">{{ gettext('Longitude') }}:</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-globe"></i></span>
                                <input type="text" class="form-control" id="Longitude" name="longitude" value="{{ ((nLongitude and (nLongitude is not same as(0))) ? nLongitude : '') }}" maxlength="50">
                            </div>
                        </div>
                    </div>
                    {% endif %}

            <!-- Second Address Section (#9743) -->
            {% set bSecondAddressExpanded = (((((bSecondIsMailing or (((sSecondAddress1|trim)|length) > 0)) or (((sSecondAddress2|trim)|length) > 0)) or (((sSecondCity|trim)|length) > 0)) or (((sSecondZip|trim)|length) > 0)) or (sSecondAddressError is not same as(''))) %}
            <div class="row mt-4">
                <div class="col-12">
                    <button class="btn btn-link p-0 text-decoration-none text-body-secondary fw-bold" type="button"
                            id="secondAddressToggle" data-bs-toggle="collapse" data-bs-target="#secondAddressSection"
                            aria-expanded="{{ (bSecondAddressExpanded ? 'true' : 'false') }}" aria-controls="secondAddressSection">
                        <i class="fa-solid fa-chevron-down me-1"></i>{{ gettext('Second Address') }}                        <span class="text-body-secondary fw-normal ms-1">({{ gettext('optional') }})</span>
                    </button>
                    {% if sSecondAddressError %}
                    <div class="small mt-1" id="SecondAddressError">{{ sSecondAddressError }}</div>
                    {% endif %}
                </div>
            </div>
            <div class="collapse{{ (bSecondAddressExpanded ? ' show' : '') }}" id="secondAddressSection">
                <div class="row mt-3">
                    <div class="mb-3 col-12 col-md-6">
                        <label for="SecondAddress1">{{ gettext('Address') }} 1:</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-location-dot"></i></span>
                            <input type="text" id="SecondAddress1" name="secondAddress1" value="{{ sSecondAddress1 }}" maxlength="250" class="form-control">
                        </div>
                    </div>
                    <div class="mb-3 col-12 col-md-6">
                        <label for="SecondAddress2">{{ gettext('Address') }} 2:</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-location-dot"></i></span>
                            <input type="text" id="SecondAddress2" name="secondAddress2" value="{{ sSecondAddress2 }}" maxlength="250" class="form-control">
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="mb-3 col-12 col-sm-6 col-md-4">
                        <label for="SecondCity">{{ gettext('City') }}:</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-city"></i></span>
                            <input type="text" id="SecondCity" name="secondCity" value="{{ sSecondCity }}" maxlength="50" class="form-control">
                        </div>
                    </div>
                    <div id="secondStateOptionDiv" class="mb-3 col-12 col-sm-6 col-md-3">
                        <label for="SecondState">{{ gettext('State') }}:</label>
                        <select id="SecondState" name="secondState" class="form-select" data-user-selected="{{ sSecondState }}" data-system-default="">
                        </select>
                    </div>
                    <div id="secondStateInputDiv" class="mb-3 col-12 col-sm-6 col-md-3 d-none">
                        <label for="SecondStateTextbox">{{ gettext('State') }}:</label>
                        <input id="SecondStateTextbox" type="text" class="form-control" name="secondStateTextbox" value="{{ sSecondState }}" maxlength="30">
                    </div>
                    <div class="mb-3 col-12 col-sm-6 col-md-2">
                        <label for="SecondZip">{{ gettext('Zip') }}:</label>
                        <input type="text" id="SecondZip" name="secondZip" class="form-control{{ (config_bool('bForceUppercaseZip') ? ' text-uppercase' : '') }}" value="{{ sSecondZip }}"  maxlength="10">
                    </div>
                    <div class="mb-3 col-12 col-sm-6 col-md-3">
                        <label for="SecondCountry">{{ gettext('Country') }}:</label>
                        <select id="SecondCountry" name="secondCountry" class="form-select" data-user-selected="{{ sSecondCountry }}" data-system-default="{{ config_attr('sDefaultCountry') }}">
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="mb-3 col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="SecondIsMailing" name="secondIsMailing" value="1" {{ (bSecondIsMailing ? 'checked' : '') }}>
                            <label class="form-check-label" for="SecondIsMailing">{{ gettext('This is the mailing address') }}</label>
                        </div>
                        <div class="form-text">{{ gettext('Mail goes to the second address; the primary address stays the physical location used for maps and directions.') }}</div>
                    </div>
                </div>
            </div>

            <!-- Contact Information Section -->
            <div class="row mt-4">
                <div class="col-12">
                    <h5 class="text-body-secondary mb-3">{{ gettext('Contact') }}</h5>
                </div>
            </div>
            <div class="row">
                <div class="mb-3 col-12 col-md-6">
                    <label for="HomePhone">{{ gettext('Home Phone') }}:</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-house"></i></span>
                        <input type="text" id="HomePhone" name="homePhone" value="{{ sHomePhone }}" maxlength="30" class="form-control" data-phone-mask='{"mask":"{{ config_attr('sPhoneFormat') }}"}'>
                        <span class="input-group-text gap-2">
                            <input class="form-check-input mt-0" type="checkbox" id="NoFormat_HomePhone" name="noFormatHomePhone" value="1" {{ (bNoFormat_HomePhone ? 'checked' : '') }}>
                            <label class="form-check-label" for="NoFormat_HomePhone">{{ gettext('No format') }}</label>
                        </span>
                    </div>
                </div>
            </div>
            {% if (not config_bool('bHideFamilyNewsletter')) %}
            <div class="row">
                <div class="mb-3 col-12 col-md-6">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="SendNewsLetter" name="sendNewsLetter" value="1" {{ (bSendNewsLetter ? 'checked' : '') }}>
                        <label class="form-check-label" for="SendNewsLetter">{{ gettext('Send Newsletter') }}</label>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
    {% if (config_bool('bUseDonationEnvelopes') and current_user().isFinanceEnabled()) %}
        <div class="card clearfix">
            <div class="card-header d-flex align-items-center">
                <h3 class="card-title">{{ gettext('Envelope Info') }}</h3>
            <div class="card-body">
                <div class="row">
                    <div class="mb-3 col-12 col-sm-6 col-md-4">
                        <label for="Envelope">{{ gettext('Envelope Number') }}:</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-envelope-open-text"></i></span>
                            <input type="text" id="Envelope" name="envelope" class="form-control" value="{{ (family ? family.getEnvelope() : '') }}" maxlength="50">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
{% if (numCustomFields > 0) %}
        <div class="card clearfix">
            <div class="card-header d-flex align-items-center">
                <h3 class="card-title">{{ gettext('Custom Fields') }}</h3>
            </div>
            <div class="card-body">
                {% set customPhoneFields = [] %}
                {% for field in rsCustomFields %}
                    {% set fieldId = field.getField() %}
                    {% set fieldType = field.getTypeId() %}
                    {% set value = aCustomData[fieldId]|default('')|trim %}
                    {% set special = field.getCustomSpecial() %}
                    {% if fieldType == 11 %}
                        {% set special = null %}
                        {% set customPhoneFields = customPhoneFields|merge([{'checkboxName': fieldId ~ 'noformat', 'inputName': fieldId}]) %}
                    {% endif %}

                    <div class="row">
                        <div class="mb-3 col-12 col-md-6">
                            <label for="{{ fieldId }}">{{ field.getName() }}</label>
                            {{ custom_form(fieldType, fieldId, value, special, not submitted) }}
                            {% if aCustomErrors[fieldId] is not empty %}

                                <span class="text-danger small">{{ aCustomErrors[fieldId] }}</span>
                            {% endif %}

                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}
    <div class="card clearfix">
        <div class="card-header d-flex align-items-center">
            <h3 class="card-title">{{ gettext('Family Members') }}</h3>
        </div>
        <div class="card-body">

            {% if (iFamilyMemberRows > 0) %}
                                {% if (iFamilyID < 0) %}
                                <div class="alert alert-info mb-3">
                                    <i class="fa-solid fa-circle-info"></i> {{ gettext('You may create family members now or add them later. All entries will become new person records.') }}                                </div>
                                {% endif %}
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr class="text-center">
                                                <th>{{ gettext('First') }}</th>
                                                <th>{{ gettext('Middle') }}</th>
                                                <th>{{ gettext('Last') }}</th>
                                                <th>{{ gettext('Suffix') }}</th>
                                                <th>{{ gettext('Gender') }}</th>
                                                <th>{{ gettext('Role') }}</th>
                                                <th>{{ gettext('Birth Month') }}</th>
                                                <th>{{ gettext('Birth Day') }}</th>
                                                <th>{{ gettext('Birth Year') }}</th>
                                                <th>{{ gettext('Classification') }}</th>
                                                <th>{{ gettext('Grade') }}</th>
                                            </tr>
                                        </thead>
                                        <tbody id="familyMembersTbody">
                                        {% if iFamilyMemberRows >= 1 %}
{% for iCount in 1..iFamilyMemberRows %}
                                            <tr>
                                                <td>
                                                    <input type="hidden" name="personId{{ iCount }}" value="{{ aPersonIDs[iCount] }}">
                                                    <input name="firstName{{ iCount }}" type="text" value="{{ aFirstNames[iCount] }}" class="form-control form-control-sm">
                                                    {% if (iCount in (aFirstNameError ?? [])|keys) %}
                                                    <span class="text-danger small">{{ aFirstNameError[iCount] }}</span>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    <input name="middleName{{ iCount }}" type="text" value="{{ aMiddleNames[iCount] }}" class="form-control form-control-sm">
                                                </td>
                                                <td>
                                                    <input name="lastName{{ iCount }}" type="text" value="{{ aLastNames[iCount] }}" class="form-control form-control-sm">
                                                </td>
                                                <td>
                                                    <input name="suffix{{ iCount }}" type="text" value="{{ aSuffix[iCount] }}" class="form-control form-control-sm" maxlength="50">
                                                </td>
                                                <td>
                                                    <select name="gender{{ iCount }}" class="form-select form-select-sm">
                                                        <option value="0" {{ ((aGenders[iCount] is same as(0)) ? 'selected' : '') }}>{{ gettext('Select Gender') }}</option>
                                                        <option value="1" {{ ((aGenders[iCount] is same as(1)) ? 'selected' : '') }}>{{ gettext('Male') }}</option>
                                                        <option value="2" {{ ((aGenders[iCount] is same as(2)) ? 'selected' : '') }}>{{ gettext('Female') }}</option>
                                                    </select>
                                                </td>
                                                <td>
                                                    <select name="role{{ iCount }}" class="form-select form-select-sm">
                                                        <option value="0" {{ ((aRoles[iCount] is same as(0)) ? 'selected' : '') }}>{{ gettext('Select Role') }}</option>
                                                        {% for role in familyRoles %}
<option value="{{ role.getOptionId() }}"{% if aRoles[iCount] == role.getOptionId() %} selected{% endif %}>{{ role.getOptionName() }}</option>{% endfor %}
                                                    </select>
                                                </td>
                                                <td>
                                                    <select name="birthMonth{{ iCount }}" class="form-select form-select-sm">
                                                        <option value="0" {{ ((aBirthMonths[iCount] is same as(0)) ? 'selected' : '') }}>{{ gettext('Unknown') }}</option>
                                                        <option value="01" {{ ((aBirthMonths[iCount] is same as(1)) ? 'selected' : '') }}>{{ gettext('January') }}</option>
                                                        <option value="02" {{ ((aBirthMonths[iCount] is same as(2)) ? 'selected' : '') }}>{{ gettext('February') }}</option>
                                                        <option value="03" {{ ((aBirthMonths[iCount] is same as(3)) ? 'selected' : '') }}>{{ gettext('March') }}</option>
                                                        <option value="04" {{ ((aBirthMonths[iCount] is same as(4)) ? 'selected' : '') }}>{{ gettext('April') }}</option>
                                                        <option value="05" {{ ((aBirthMonths[iCount] is same as(5)) ? 'selected' : '') }}>{{ gettext('May') }}</option>
                                                        <option value="06" {{ ((aBirthMonths[iCount] is same as(6)) ? 'selected' : '') }}>{{ gettext('June') }}</option>
                                                        <option value="07" {{ ((aBirthMonths[iCount] is same as(7)) ? 'selected' : '') }}>{{ gettext('July') }}</option>
                                                        <option value="08" {{ ((aBirthMonths[iCount] is same as(8)) ? 'selected' : '') }}>{{ gettext('August') }}</option>
                                                        <option value="09" {{ ((aBirthMonths[iCount] is same as(9)) ? 'selected' : '') }}>{{ gettext('September') }}</option>
                                                        <option value="10" {{ ((aBirthMonths[iCount] is same as(10)) ? 'selected' : '') }}>{{ gettext('October') }}</option>
                                                        <option value="11" {{ ((aBirthMonths[iCount] is same as(11)) ? 'selected' : '') }}>{{ gettext('November') }}</option>
                                                        <option value="12" {{ ((aBirthMonths[iCount] is same as(12)) ? 'selected' : '') }}>{{ gettext('December') }}</option>
                                                    </select>
                                                </td>
                                                <td>
                                                    <select name="birthDay{{ iCount }}" class="form-select form-select-sm">
                                                        <option value="0">{{ gettext('Unk') }}</option>
                                                        {% if (32 - 1) >= 1 %}
{% for x in 1..(32 - 1) %}
{% set sDay = ((x < 10) ? ('0' ~ x) : x) %}
                                                            <option value="{{ sDay }}" {{ ((aBirthDays[iCount] is same as(x)) ? 'selected' : '') }}>{{ x }}</option>
                                                        {% endfor %}
{% endif %}
                                                    </select>
                                                </td>
                                                <td>
                                                    {% if ((not (iCount in (aperFlags ?? [])|keys)) or (not aperFlags[iCount])) %}
{% set UpdateBirthYear = 1 %}
                                                        <input name="birthYear{{ iCount }}" type="text" value="{{ aBirthYears[iCount] }}" class="form-control form-control-sm" maxlength="4">
                                                        {% if (iCount in (aBirthDateError ?? [])|keys) %}
                                                        <span class="text-danger small">{{ aBirthDateError[iCount] }}</span>
                                                        {% endif %}
{% else %}
{% set UpdateBirthYear = 0 %}
{% endif %}
                                                </td>
                                                <td>
                                                    <select name="classification{{ iCount }}" class="form-select form-select-sm">
                                                        <option value="0" {{ ((aClassification[iCount] is same as(0)) ? 'selected' : '') }}>{{ gettext('Unassigned') }}</option>
                                                        <option value="" disabled>-----------------------</option>
                                                        {% for option in classifications %}
{% set lst_OptionID = option.getOptionId() %}
{% set lst_OptionName = option.getOptionName() %}
<option value="{{ lst_OptionID }}"{% if (aClassification[iCount] == lst_OptionID) %} selected{% endif %}>{{ lst_OptionName }}</option>{% endfor %}
                                                    </select>
                                                </td>
                                                <td>
                                                    <select name="grade{{ iCount }}" class="form-select form-select-sm">
                                                        <option value="">{{ gettext('Unassigned') }}</option>
                                                        {% for gradeId, gradeName in grade_names() %}
                                                            <option value="{{ gradeId }}"{{ (((aGrades[iCount] ?? null) is same as(gradeId)) ? ' selected' : '') }}>{{ gradeName }}</option>
                                                        {% endfor %}
                                                    </select>
                                                </td>
                                            </tr>
                                        {% endfor %}
{% endif %}
                                        </tbody>
                                    </table>
                                </div>
                                {% if (iFamilyID < 0) %}
                                <div class="mt-3">
                                    <button type="button" class="btn btn-outline-primary btn-sm" id="addFamilyMemberRow">
                                        <i class="fa-solid fa-plus"></i>{{ gettext('Add Another Family Member') }}                                    </button>
                                </div>
                                {% endif %}                            {% endif %}
                        </div>
                    </div>

                    <input type="hidden" name="updateBirthYear" value="{{ UpdateBirthYear }}">

                    <!-- Form submit buttons -->
                    <div class="d-flex gap-2 mt-4">
                        <!-- Primary action: Save (green) -->
                        <button type="submit" name="familySubmit" class="btn btn-success flex-grow-1">
                            <i class="fa-solid fa-check me-2"></i>{{ gettext('Save') }}                        </button>
                        <!-- Secondary action: Save and Add (blue) -->
                        {% if current_user().isAddRecordsEnabled() %}
                        <button type="submit" name="familySubmitAndAdd" class="btn btn-info flex-grow-1">
                            <i class="fa-solid fa-people-roof me-2"></i>{{ gettext('Save and Add New Family') }}                        </button>
                        {% endif %}
                        <!-- Tertiary action: Cancel (gray) -->
                        {% if (iFamilyID > 0) %}
                        <a href="{{ root_path() }}/people/family/{{ iFamilyID }}" class="btn btn-secondary">
                            <i class="fa-solid fa-xmark me-2"></i>{{ gettext('Cancel') }}                        </a>
                        {% else %}
                        <a href="{{ root_path() }}/people/family" class="btn btn-secondary">
                            <i class="fa-solid fa-xmark me-2"></i>{{ gettext('Cancel') }}                        </a>
                        {% endif %}
                    </div>
                </form>

{% if (iFamilyID < 0) %}
<script nonce="{{ csp_nonce() }}">
    window.CRM.familyRoles = {{ json_script(familyRolesJS) }};
    window.CRM.classifications = {{ json_script(classificationsJS) }};
    window.CRM.grades = {{ json_script(grade_options()) }};

    window.CRM.initialFamilyMemberCount = {{ iFamilyMemberRows }};
    window.CRM.i18n = {
        selectGender: {{ json_script(gettext('Select Gender')) }},
        male: {{ json_script(gettext('Male')) }},
        female: {{ json_script(gettext('Female')) }},
        selectRole: {{ json_script(gettext('Select Role')) }},
        unknown: {{ json_script(gettext('Unknown')) }},
        unassigned: {{ json_script(gettext('Unassigned')) }},
        months: [
            {{ json_script(gettext('January')) }},
            {{ json_script(gettext('February')) }},
            {{ json_script(gettext('March')) }},
            {{ json_script(gettext('April')) }},
            {{ json_script(gettext('May')) }},
            {{ json_script(gettext('June')) }},
            {{ json_script(gettext('July')) }},
            {{ json_script(gettext('August')) }},
            {{ json_script(gettext('September')) }},
            {{ json_script(gettext('October')) }},
            {{ json_script(gettext('November')) }},
            {{ json_script(gettext('December')) }}        ]
    };
</script>
{% endif %}
<script nonce="{{ csp_nonce() }}">window.CRM.customPhoneFields = {{ json_script(customPhoneFields|default([])) }};</script>
<script src="{{ asset_url('/skin/js/DropdownManager.js') }}"></script>
<script src="{{ asset_url('/skin/v2/family-editor.min.js') }}"></script>
